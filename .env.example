# Address receiving tool-call payments: your Catena sandbox account's
# base-sepolia USDC deposit address.
SELLER_PAY_TO_ADDRESS=

# Price of one paid tool invocation.
TOOL_PRICE_USD=$0.02

# Funded Base Sepolia key the paying proxy signs payments with (USDC only,
# no ETH needed; transfers are gasless EIP-3009).
BUYER_EVM_PRIVATE_KEY=

#MCP_PORT=4040
#UPSTREAM_MCP_URL=http://localhost:4040/mcp
#X402_FACILITATOR_URL=https://x402.org/facilitator

# Total the paying proxy may spend across its lifetime.
#PROXY_SPEND_CAP_USD=$0.10
