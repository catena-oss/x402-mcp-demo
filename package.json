{
  "name": "x402-mcp-demo",
  "version": "0.1.0",
  "description": "MCP server with x402-metered tool calls, plus a paying-proxy reference client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catena-oss/x402-mcp-demo.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "server": "tsx src/server/main.ts",
    "proxy": "tsx src/proxy/main.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/fetch": "2.21.0",
    "express": "^5.1.0",
    "viem": "^2.31.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "prettier": "^3.9.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.0"
  }
}
